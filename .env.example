# ==============================================================================
# minimy Search Agent Environment Configuration
# ==============================================================================

# --- LLM Providers (Configure at least ONE) ---
# Default provider will auto-detect based on available keys:
# Priority: OPENAI_API_KEY -> ANTHROPIC_API_KEY -> GEMINI_API_KEY

# OpenAI (Recommended: gpt-4o or gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (e.g., claude-3-5-sonnet-latest)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (e.g., gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default model (defaults to gpt-4o-mini for speed & cost)
# MODEL_NAME=gpt-4o-mini
# MODEL_PROVIDER=openai

# --- Web Search Tool Providers ---
# 1. Tavily Search (Recommended for AI agents: clean markdown, snippet extraction)
#    Get a free API key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 2. Brave Search (Optional alternative)
#    Get an API key at https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Search provider selection: "tavily" | "brave" | "duckduckgo"
# If no key is set, the system gracefully falls back to "duckduckgo" (no key needed!)
SEARCH_PROVIDER=tavily

# --- System / Temporal Configuration ---
# Optional: Set a fixed reference date for reproducible testing/benchmarking (ISO format: YYYY-MM-DD)
# Leave empty for real-time live clock (default)
# SIMULATED_DATE=2026-11-15
